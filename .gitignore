# ============================================================
# Smart Rights Viewer — Native App (React Native / Expo)
# ============================================================

# ── Dependencies ───────────────────────────────────────────
node_modules/

# ── Expo / Metro ───────────────────────────────────────────
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts

# ── Native folders (สร้างอัตโนมัติจาก `expo prebuild` ไม่ต้องเก็บ) ──
/android
/ios

# ── 🔐 Signing keys & credentials (ห้าม push เด็ดขาด) ───────
*.keystore
*.jks
*.p8
*.p12
*.key
*.pem
*.mobileprovision
credentials.json
signing-key-info.txt
google-services.json
GoogleService-Info.plist

# ── ไฟล์แอปที่ build เสร็จแล้ว ──────────────────────────────
*.apk
*.aab
*.ipa

# ── Environment ────────────────────────────────────────────
# (.env.example ยัง push ได้ เพื่อบอกว่าต้องตั้งค่าอะไรบ้าง)
.env
.env.*
!.env.example

# ── Debug logs ─────────────────────────────────────────────
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# ── TypeScript ─────────────────────────────────────────────
*.tsbuildinfo

# ── Editor / IDE ───────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── OS ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Temp / archive ─────────────────────────────────────────
*.tmp
*.orig.*
*.zip